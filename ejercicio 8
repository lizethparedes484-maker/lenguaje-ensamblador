.Const

.Data?
ResultadoEnTexto Byte 5 Dup (?) ; es para convertr nuestro resultado a resultado en texto y asi poder mostrarlo
.Data
Titulo Byte "lizeth", 0         ; titulo que tendra la ventana
resultado DWord 0H              ; en esta variable se va a guardar el resultado por eso esta declarada en cero
   ; Producto A : 4 unidades x 25
   cantA   DWord 4H
   precioA   DWord 19H

   ; Producto B: 2 unidades x 60
   cantB DWord 2H
   precioB DWord 3CH

   ; Producto C: 5 unidades x 15
   cantC DWord 5H
   precioC DWord 0FH

.Code

start:
	Mov Ebx, 0                ; ebx inicia en cero


    ; Producto A: 4*25 = 100
    Mov Eax, cantA
    IMul Eax, precioA          ; eax = 4*25 = 100
    Add Ebx, Eax               ; ebx = 0 +100 = 100

   ; Producto B: 2*60 = 120
    Mov Eax, cantB
    IMul Eax, precioB
    Add Ebx, Eax

     ; Producto B: 5*15= 75
    Mov Eax, cantC
    IMul Eax, precioC
    Add Ebx, Eax
    Mov resultado, Ebx

    ; nos muestra los resultados
	Invoke dwtoa, resultado, Addr ResultadoEnTexto
	Invoke MessageBox, 0, Addr ResultadoEnTexto, Addr Titulo, MB_OK
	Invoke ExitProcess, 0
End start
