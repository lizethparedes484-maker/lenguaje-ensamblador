.Const
.Data?
   ResultadoEnTexto Byte 5 Dup (?) ; Sirve para guardar el número convertido a texto
.Data

   Titulo Byte "lizeth", 0  ; Es el nombre del titulo que tendra la ventana
   NumeroUno DWord 9H       ; Primer número declarado (9 en decimal)
   NumeroDos DWord 5H       ; Segundo número declarado (5 en decimal)
   NumeroTres DWord 2H       ; Tercer número declarado(2 en decimal)
   Numerofour DWord 3H       ; Cuarto número declarado (3 en decimal)

   Resultado DWord 0H        ; Variable para almacenar la suma
.Code

start:                       ; Inicio del programa
	Mov Eax, NumeroUno       ; Carga 9 en el registro EAX
	Add Eax, NumeroDos       ; Suma 5
	Add Eax, NumeroTres      ; Suma 2
	Add Eax, Numerofour      ; Suma 3


	Mov Resultado, Eax        ; Es el resultado de la suma

	Invoke dwtoa, Resultado, Addr ResultadoEnTexto    ; Convierte el resultado en texto para poderse mostrar

	Invoke MessageBox, 0, Addr ResultadoEnTexto, Addr Titulo, MB_OK   ; Manda a llamar el resultado de la suma , y el titulo en una ventana emergente

	Invoke ExitProcess, 0     ; Cierra la ventana

End start                    ; termina el codigo
