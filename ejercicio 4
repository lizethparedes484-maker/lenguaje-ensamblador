.Const

.Data?
ResultadoEnTexto Byte 5 Dup (?)

.Data
Titulo Byte  "halloween ", 0
Operador DWord 0AH
Resultado DWord   0H


.Code

start:
    Mov Eax, 2

    IMul Eax, Operador

    Mov Resultado, Eax  ; para guardar el resultado

    Invoke dwtoa, Resultado, Addr ResultadoEnTexto

    Invoke MessageBox, 0, Addr ResultadoEnTexto, Addr Titulo, MB_OK

	Invoke ExitProcess, 0
End start

