"""
Ejercicio 7: Traduce la siguiente expresión matemática a ensamblador

Resultado = ((A . B) + C) - D
"""

.Const

.Data?
ResultadoEnTexto Byte 5 Dup (?)     ; Convierte de numero a texto
.Data
Titulo Byte "party", 0  ; Nombre del titulo que aparecera en la ventana
Numero_A DWord 2H       ; A vale 2
Numero_B DWord 3H       ; B vale 3
Numero_C DWord  4H      ; C vale 4
Numero_D DWord  5H      ; D vale 5
Resultado DWord 0H      ; variable donde se guardara el total

.Code

start:
    Mov Eax, Numero_A   ; Guarda el valor 2
    IMul Eax, Numero_B  ; Multipplica por 3
    Add Eax, Numero_C   ; Suma 4
    Sub Eax, Numero_D   ; Resta 5
    Mov Resultado, Eax  ; Guarda el total en la variable resultado

   
    Invoke dwtoa, Resultado, Addr ResultadoEnTexto     ; Convierte el reultado a resultado en texto y lo muestra
    Invoke MessageBox, 0, Addr ResultadoEnTexto, Addr Titulo, MB_OK    ;Abre la ventana y muestra todo
    Invoke ExitProcess, 0    ; Cierra la ventana 


End start
