"""
1.Un personaje recibe 3 golpes seguidos. Cada golpe causa un daño distinto. Calcula el daño total recibido.
2.Si el daño total es menor a 50 (daño_total < 50), imprime "Armadura intacta"
3.Si el daño total es mayor o igual a 50, resta 10 al total e imprime el total.
4.Final: Imprimir siempre "Estado de combate actualizado"
"""

.Const
.Data?
ResultadoEnTexto Byte 10 Dup (?)                ; Convierte mi resultado de numero a texto
.Data
titulo23 Byte "lpc", 0                          ; Título para mi ventana
adios Byte "estado de compate actualizado", 0   ; Mensaje final
titulo1 Byte "armadura intacta", 0              ; Mensaje cuando el daño es menor a 50
titulo2 Byte "armadura dañada ", 0              ; Mensaje si la condicion no se cumplio
resultado DWord 0H                              ; Aqui se va a guardar el total
.Code
start:
    Mov Eax, 87                                 ; Es el valor incial
    Add Eax, 5                                  ; Sumo el daño del segundo golpe
    Add Eax, 9                                  ; Sumo el daño del tercer golpe (acumulando el total)

    Cmp Eax, 50                                 ; Se compara mi daño con el límite de 50
    Jl ejecuta_este_bloque                      ; Si se cumple la condicion salto a este bloque (armadura intacta)
    
    ; Si el daño total es mayor o igual a 50, ejecuto esto:
    Sub Eax, 10                                 ; Resto 10 al total
    Mov resultado, Eax                          ; Guardo el resultado en mi variable resultado
    Invoke dwtoa, resultado, Addr ResultadoEnTexto ; Convierto total de numero a texto
    Invoke MessageBox, 0, Addr ResultadoEnTexto, Addr titulo23, MB_OK
    Jmp salida                                  ; Salto al cierre del programa
ejecuta_este_bloque:
    Invoke MessageBox, 0, Addr titulo1, Addr titulo23, MB_OK   ; Se muestra el mesaje " armadura intacta"
salida:
    Invoke MessageBox, 0, Addr adios, Addr titulo23, MB_OK     ; Se muestra el mensaje final
    Invoke ExitProcess, 0  ; Cierra la ventana
End start
