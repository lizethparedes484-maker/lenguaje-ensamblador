"""
Ejercicio 6: Restar 3 a 10 con Sub
"""

.Const

.Data?
ResultadoEnTexto Byte 5 Dup (?)    ; Convierte numero a texto
.Data
Titulo Byte "party", 0     ; El titulo de la ventana en party
Numeero DWord 0AH          ; El primer numero es 10
numero DWord 3H            ; El segundo numero es 3
Resultado DWord 0H         ; En esta variable se guardara el resultado

.Code

start:
    Mov Eax, Numeero       ; Trae el valor 10
    Sub Eax, numero        ; Resta 3
    Mov Resultado, Eax     ; Almacena ese resultado en la variable resultado
    Invoke dwtoa, Resultado, Addr ResultadoEnTexto                      ; Convierte el resultado a texto
    Invoke MessageBox, 0, Addr ResultadoEnTexto, Addr Titulo, MB_OK     ; Abre la ventana con todo(titulo, resultado)
    Invoke ExitProcess, 0  ; Cierra todo


End start
