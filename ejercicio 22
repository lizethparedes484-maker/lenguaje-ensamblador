"""
1.Un estudiante cursa 3 materias modulares que tienen diferente valor en créditos (variable creditos_materia). Calcula el avance sumado.
2.Si los créditos acumulados son mayor o igual a 45 (creditos >= 45), imprime "Habilitado para tramite de servicio social"
3.Si es menor a 45, imprime "Creditos pendientes para liberacion"
4.Final: Imprimir siempre "Consulta de expediente concluida"
"""
.Const

.Data?
ResultadoEntexto Byte 10 Dup(?)            ; Para convertir el resultado a resultado en texto

.Data
titulov          Byte "Control Escolar", 0     ; Título de la ventana principal
titulo1          Byte "Habilitado para tramite de servicio social", 0 ; Si creditos >= 45
titulo2          Byte "Creditos pendientes para liberacion", 0 ; Si creditos < 45
final            Byte "Consulta de expediente concluida", 0    ; Mensaje que aparecera al final
creditos_materia1 DWord 15                     ; Creditos de la materia 1
creditos_materia2 DWord 20                     ; Creditos de la materia 2
creditos_materia3 DWord 15                     ; Creditos de la materia 3
minimo           DWord 45                      ; Minimo de creditos requeridos

.Code
start:
    Mov Eax, 0            ; Empezamos con Eax en cero
    Add Eax, creditos_materia1 ; Suma creditos materia 1
    Add Eax, creditos_materia2 ; Suma creditos materia 2
    Add Eax, creditos_materia3 ; Suma creditos materia 3
    
    ; Comparamos si los creditos acumulados son mayor o igual a 45
    Cmp Eax, minimo        
    Jge habilitado        ; Si los creditos son mayor o igual, salta a este bloque

    ; Si los creditos son menores al minimo requerido
    Invoke MessageBox, 0, Addr titulo2, Addr titulov, MB_OK
    Jmp salida

habilitado:
    ; Si los creditos son mayor o igual
    Invoke dwtoa, Eax, Addr ResultadoEntexto
    Invoke MessageBox, 0, Addr titulo1, Addr titulov, MB_OK
    Invoke MessageBox, 0, Addr ResultadoEntexto, Addr titulov, MB_OK

salida:
    ; Mensaje final
    Invoke MessageBox, 0, Addr final, Addr titulov, MB_OK
    Invoke ExitProcess, 0
End start
